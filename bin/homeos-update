#!/bin/bash
# Starts a HomeOS update. Run as root, without arguments:  sudo homeos-update
#
# install.sh allows the HomeOS user to run exactly this file with sudo and no
# password, which is what "Install update" in Settings uses. Nothing the user
# can change is run as root: the remote and branch come from /opt/homeos/source
# (written by install.sh, only root can change it), the code is fetched by root
# into /var/lib/homeos/src (owned by root), and install.sh runs from there.
# The work (bin/homeos-update-job) runs as a separate system job so that it
# survives the restart of web access. It is a file, not a script passed on the
# command line: systemd-run would replace every $NAME in such a script itself.
set -euo pipefail

SOURCE=/opt/homeos/source
LOG=/var/log/homeos-update.log
UNIT=homeos-update

[ "$(id -u)" -eq 0 ] || { echo "Run this with sudo." >&2; exit 1; }
[ "$#" -eq 0 ] || { echo "homeos-update takes no arguments." >&2; exit 2; }
[ "$(stat -c %u "$SOURCE")" -eq 0 ] || { echo "$SOURCE must belong to root." >&2; exit 1; }

REMOTE="" BRANCH="" FLAGS="" OWNER=""
while IFS='=' read -r key value; do
    case "$key" in
        REMOTE) REMOTE=$value ;;
        BRANCH) BRANCH=$value ;;
        FLAGS) FLAGS=$value ;;
        OWNER) OWNER=$value ;;
    esac
done < "$SOURCE"

for flag in $FLAGS; do
    case "$flag" in
        --web|--web-only|--no-autostart|--lite|--no-chromium) ;;
        *) echo "Unexpected install option: $flag" >&2; exit 1 ;;
    esac
done
id "$OWNER" >/dev/null 2>&1 || { echo "The HomeOS user is not recorded. Run install.sh again." >&2; exit 1; }
case "$REMOTE" in
    https://*|ssh://*|git@*) ;;
    *) echo "No update address is recorded. Run install.sh once from the console." >&2; exit 1 ;;
esac
printf '%s' "$BRANCH" | grep -Eq '^[A-Za-z0-9._/-]+$' \
    || { echo "No update branch is recorded. Run install.sh once from the console." >&2; exit 1; }

if systemctl is-active --quiet "$UNIT"; then
    exit 0          # an update is already running
fi

exec systemd-run --unit "$UNIT" --collect --quiet \
    --setenv=HOMEOS_OWNER="$OWNER" --setenv=HOMEOS_REMOTE="$REMOTE" --setenv=HOMEOS_BRANCH="$BRANCH" \
    --setenv=HOMEOS_FLAGS="$FLAGS" \
    -p StandardOutput=truncate:"$LOG" -p StandardError=inherit \
    /bin/bash /opt/homeos/bin/homeos-update-job
